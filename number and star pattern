#normal
for i in range(1, 5):
    for j in range(1, i + 1):
        print(j, end=" ")
    print()
#star
for i in range(1, 5):
    for j in range(1, i + 1):
        print(*, end=" ")
    print()
# reverse
for i in range(5, 0, -1):
    for j in range(5, 5-i, -1):
        print(j, end=" ")
    print()
