
numbers = list(map(int, input("Enter numbers: ").split()))

current_sum = numbers[0]
max_sum = numbers[0]

for i in range(1, len(numbers)):
    current_sum = max(numbers[i], current_sum + numbers[i])

    if current_sum > max_sum:
        max_sum = current_sum

print("Maximum subarray sum:", max_sum)
